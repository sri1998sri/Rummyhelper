<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Floating Rummy Assistant"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStartAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Floating Assistant" />

        <Button
            android:id="@+id/btnStopAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Floating Assistant" />

        <Button
            android:id="@+id/btnOpenAccessibilitySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility Service"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overlay Permission: Unknown"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtAccessibilityStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accessibility Service: Unknown" />

        <Button
            android:id="@+id/btnStartScreenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Screenshot Recognition"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnManualEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manual Card Entry" />

        <TextView
            android:id="@+id/txtCardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detected Cards: 0/13"
            android:textSize="18sp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtHandValidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hand: Incomplete"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
