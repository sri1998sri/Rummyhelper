<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtComparisonHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Arrangement Comparison"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtScenario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scenario: Comparing Original vs Discard 7♠"
        android:textColor="#BDBDBD"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Current Hand Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#22FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtCurrentArrangement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No arrangement"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtCurrentPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points: 0"
                android:textColor="@color/teal_200"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:background="#44FFFFFF" />

        <!-- Alternative Hand Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#22FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTERNATIVE"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtAltArrangement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No arrangement"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtAltPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Points: 0"
                android:textColor="@color.teal_200"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseComparison"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Close Comparison"
        android:layout_gravity="center"
        android:layout_marginTop="24dp" />

</LinearLayout>
